APP_NAME=TAX-SHIELD
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=./data/uploads
INDEX_DIR=./data/index
TOP_K=6
RRF_K=60
KEYWORD_CANDIDATES=20
SEMANTIC_CANDIDATES=20

# Semantic embeddings use Sentence Transformers; first index build downloads this model.
# The separate provider below remains optional for the existing hybrid chat retriever.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SEMANTIC_SIMILARITY_THRESHOLD=0.20
# Set SEMANTIC_EMBEDDING_MODEL separately when EMBEDDING_MODEL is an Ollama/API model name.
# SEMANTIC_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Required for evidence-backed answers when retrieved passages exist. No fake answer fallback is used.
# Groq uses its OpenAI-compatible Chat Completions endpoint. Put your private key in backend/.env only.
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# For local Ollama instead: set LLM_PROVIDER=ollama and select a model installed in Ollama.

# Ingestion and persistence limits
MAX_PDF_MB=20
CHUNK_WORDS=850
CHUNK_OVERLAP_WORDS=120
# TAXSHIELD_DB=./data/taxshield.sqlite3
